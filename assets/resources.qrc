        <file alias="PlayerBar.qml">qml/PlayerBar.qml</file>
        <file alias="Sidebar.qml">qml/Sidebar.qml</file>
        <file alias="HomeCard.qml">qml/HomeCard.qml</file>
        <file alias="HomeView.qml">qml/HomeView.qml</file>
        <file alias="TrendingView.qml">qml/TrendingView.qml</file>
        <file alias="TrackRow.qml">qml/TrackRow.qml</file>
        <file alias="AlbumDetailView.qml">qml/AlbumDetailView.qml</file>
        <file alias="PlaylistDetailView.qml">qml/PlaylistDetailView.qml</file>
        <file alias="ArtistDetailView.qml">qml/ArtistDetailView.qml</file>
        <file alias="ShowDetailView.qml">qml/ShowDetailView.qml</file>
        <file alias="LibraryView.qml">qml/LibraryView.qml</file>
