{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "https://cc.freemodel.dev",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    },
    "nvidia": {
      "name": "NVIDIA",
      "api": "openai",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "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"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2",
          "id": "z-ai/glm-5.2",
          "family": "glm",
          "limit": {
            "context": 131072,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0
          }
        }
      }
    }
  },
  "model": "anthropic/claude-sonnet-4-20250514",
  "lsp": true,
  "instructions": [
    "AGENTS.md",
    "planes/implementation_plan.md"
  ],
  "mcp": {
    "rust-analyzer": {
      "type": "local",
      "command": ["rust-analyzer-mcp"],
      "enabled": true
    },
    "clangd": {
      "type": "local",
      "command": ["/home/eirom/.local/bin/clangd-mcp-server"],
      "enabled": true
    },
    "qt-docs": {
      "type": "remote",
      "url": "https://qt-docs-mcp.qt.io/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sqlite", "--db-path", "{env:DOREMI_DB_PATH}"],
      "enabled": false
    }
  },
  "command": {
    "build": {
      "template": "Ejecuta `cargo build --release 2>&1` en Doremi/. Si hay errores, léelos y sugiere correcciones.",
      "description": "Build Doremi release"
    },
    "check": {
      "template": "Ejecuta `cargo check --all-targets 2>&1` en Doremi/. Reporta errores de compilación.",
      "description": "Check compilation"
    },
    "test": {
      "template": "Ejecuta `cargo test 2>&1` en Doremi/. Muestra resumen de tests pasados/fallidos.",
      "description": "Run Rust tests"
    },
    "lint": {
      "template": "Ejecuta `cargo clippy --all-targets 2>&1` en Doremi/. Revisa warnings y errores.",
      "description": "Run Clippy lints"
    },
    "bridge": {
      "template": "Lista las funciones del bridge Rust/C++ en src/bridge.rs. Muestra un resumen de los contratos actuales mayor={CONTRACT_MAJOR} minor={CONTRACT_MINOR}.",
      "description": "Show bridge contract status"
    }
  }
}
